# Server (cargo run -p ideaplanner-server)
# Postgres connection, e.g. Neon. Leave unset to keep boards in memory.
DATABASE_URL=
# Built web app the server hosts.
WEB_DIST=web/dist/client
PORT=3001
# Origins allowed to call the API from other hosts (desktop/mobile builds).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost

# Web build (read by Vite at build time)
# API base for desktop/mobile builds that should sync with the server.
VITE_API_URL=
# Public address used in share links and QR codes.
VITE_PUBLIC_URL=
