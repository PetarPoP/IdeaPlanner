# Server (cargo run -p ideaplanner-server)
# Postgres connection, e.g. Neon. Leave unset to keep boards in memory.
DATABASE_URL=
# Built web app the server hosts.
WEB_DIST=web/dist/client
PORT=3001
# Address people open the app at (sign-in links, Google redirect, invites).
PUBLIC_URL=http://localhost:3000
# Email (sign-in links/codes, invites, daily reminder digest) via resend.com.
# Unset: emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Idea Planner <onboarding@resend.dev>
DIGEST_HOUR_UTC=7
# Sign in with Google: OAuth web client, redirect {PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Receipt scanning and booking emails → Booking cards.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Origins allowed to call the API from other hosts (desktop/mobile builds).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost
# Email in: mail to board-<id>@INBOX_DOMAIN, forwarded as raw MIME to
# POST /api/inbox with "Authorization: Bearer INBOX_TOKEN", becomes a card.
INBOX_TOKEN=
INBOX_DOMAIN=

# Web build (read by Vite at build time)
# API base for desktop/mobile builds that should sync with the server.
VITE_API_URL=
# Public address used in share links and QR codes.
VITE_PUBLIC_URL=
# Dev only: proxy /api (and live editing) to a server on :3001.
VITE_DEV_API=
