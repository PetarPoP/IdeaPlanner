{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Idea Planner",
  "version": "0.1.0",
  "identifier": "com.example.ideaplanner",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ./web",
    "beforeBuildCommand": "npm run build --prefix ./web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Idea Planner",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

